{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=itqan.db"
  },
  "Jwt": {
    "Issuer": "ItqanApi",
    "Audience": "ItqanFrontend",
    "Key": "set-a-real-secret-in-appsettings.Development.json-or-an-environment-variable"
  },
  "Cors": {
    "Origins": []
  },
  "FrontendPath": "../frontend"
}
